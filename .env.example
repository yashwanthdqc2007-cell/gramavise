# ==============================================================================
# GRAMAVISE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env before starting development: cp .env.example .env
# ==============================================================================

# Application Environment (development, testing, production)
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-use-a-random-secret-key

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/gramavise
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gramavise
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Backend API Configuration & Security Limits
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_REQUEST_SIZE_BYTES=1048576

# Frontend Configuration (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=GramaVise
NEXT_PUBLIC_DEFAULT_LANGUAGE=en

# AI & LLM Provider Configuration
LLM_PROVIDER=mock  # Options: mock, openai, anthropic, gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TEMPERATURE=0.2

# OpenStreetMap & Geospatial Services
OSM_API_URL=https://nominatim.openstreetmap.org
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
GEO_USER_AGENT=GramaVise-Rural-Business-Advisor/1.0

# External Government Data Sources & Scheme Repositories (Stubs)
MY_SCHEME_API_URL=https://api.myscheme.gov.in
DATA_GOV_IN_API_KEY=
